# VietLaw-Chat MVP local environment example
# Copy values into a local .env file when running the backend.
# Do not commit real API keys or secrets.

APP_ENV=development
LOG_LEVEL=info
BACKEND_MODE=lite

# Provider-neutral AI config. Backend config may map this to a concrete provider.
AI_API_KEY=your_api_key_here
AI_MODEL_NAME=api-model
AI_BASE_URL=
ANTHROPIC_API_KEY=
VIETLAW_LLM_ENABLED=1
VIETLAW_LLM_MODEL=claude-sonnet-4-6

# FAST DEMO V2 local configuration
VIETLAW_FAST_DEMO_V2_ENABLED=1
VIETLAW_FAST_DEMO_TIMEOUT_S=30
VIETLAW_FAST_DEMO_MAX_TOKENS=2048
VIETLAW_FAST_DEMO_STRUCTURED_OUTPUT=0

# Runtime paths
CHAT_DB_PATH=/tmp/vietlaw_fast_demo_live.sqlite3
LEGAL_SNIPPETS_PATH=./data/legal_snippets.json
UNSAFE_PATTERNS_PATH=./data/unsafe_patterns.json

# CORS/demo settings
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# ---------------------------------------------------------------------------
# Evaluation (evaluation/, scripts/run_eval_full.py)
#
# The evaluation system talks to a backend only over HTTP and needs no secrets.
# These are convenience defaults; every one can be passed on the command line.
# ---------------------------------------------------------------------------

# Targets. Production is the teammate's backend/, reference is backend_lite/.
EVAL_PRODUCTION_URL=http://127.0.0.1:8000
EVAL_REFERENCE_URL=http://127.0.0.1:8010

# Fixed seed so generated (metamorphic) cases are reproducible across runs.
EVAL_SEED=20260713
EVAL_REPORT_DIR=outputs/eval

# Use a throwaway DB for evaluation so runs never touch demo chat history.
EVAL_CHAT_DB_PATH=/tmp/vietlaw_eval.sqlite3

# Optional LLM-as-judge. OFF by default and never required: the core suites must
# run with no network access beyond the backend under test. If you enable it, the
# judge can only add a human-review flag — it can never turn a deterministic
# failure into a pass, and it is never the sole reason a case fails.
# EVAL_LLM_JUDGE=0
# ANTHROPIC_API_KEY=your_api_key_here

# =============================================================================
# VietLaw Limited Demo — Railway deployment configuration (backend)
#
# Set these as Railway service environment variables (Dashboard ->
# Variables), never by baking them into Dockerfile.backend or committing a
# real `.env`. See DEPLOY_RAILWAY_CLOUDFLARE.md for the full owner walkthrough
# and VIETLAW_LIMITED_DEMO_DEPLOYMENT_ARCHITECTURE_V1.md for why each
# constraint below exists.
# =============================================================================

# -- application environment --------------------------------------------------
APP_ENV=production
LOG_LEVEL=info
BACKEND_MODE=lite

# -- persistent SQLite path (Railway volume mounted at /data) -----------------
# ALL of this backend's SQLite-backed state (chat history, FAST DEMO V2
# per-chat state, the legal-fallback vertical's per-chat state, and
# idempotency receipts) lives in ONE file at this path -- they are separate
# tables in the same database, not separate files. Point it under the
# mounted volume so it survives a redeploy/restart; do not leave it at the
# image-relative default in a deployed environment.
#
# Deployment Correction Round 1 (HIGH-01): in APP_ENV=production, this is no
# longer advisory -- `backend_lite/app/storage_readiness.py` REJECTS
# startup unless: CHAT_DB_PATH is set explicitly, is absolute, resolves
# beneath /data, and /data is verified (via /proc/self/mountinfo, not just
# `exists()`) to be an ACTUAL mounted Railway volume, not merely a directory
# the image happened to create in its own writable layer. A normal
# image-local /data directory (no volume attached) is REJECTED, not treated
# as persistent -- the container fails to start rather than silently write
# chat data that a redeploy will discard. Development/test are unaffected:
# CHAT_DB_PATH may be unset there and the existing project-relative default
# still applies unchanged.
CHAT_DB_PATH=/data/vietlaw_chat.sqlite3
# Curated data is read-only and ships inside the image -- these normally
# never need to change, but are documented here for completeness.
LEGAL_SNIPPETS_PATH=/app/data/legal_snippets.json
UNSAFE_PATTERNS_PATH=/app/data/unsafe_patterns.json

# -- feature flags (task's required deployment values) ------------------------
VIETLAW_FAST_DEMO_V2_ENABLED=1
VIETLAW_TRAFFIC_PACK_ENABLED=1
# Official legal search MUST remain disabled: no live-search-provider
# integration is wired in this codebase (see
# `legal_fallback_orchestrator.py`'s docstring and `dependencies.py::
# _build_legal_fallback_orchestrator`'s "Known limitations" note) --
# setting this to 1 without a real provider does not enable search, it just
# lies about capability. Fail closed: leave it 0.
VIETLAW_OFFICIAL_LEGAL_SEARCH_ENABLED=0

# FAST DEMO V2's own LLM call (the conversational rental-deposit flow) is a
# SEPARATE concern from the traffic pack above, which is fully
# deterministic and needs no LLM at all. Only set these if the limited demo
# is meant to run the live deposit conversation; a real key is a secret and
# must be set directly in the Railway dashboard, never committed here.
# VIETLAW_LLM_ENABLED=1
# VIETLAW_LLM_MODEL=claude-sonnet-5
# ANTHROPIC_API_KEY=

# -- CORS: exact-origin allowlist, never a wildcard ---------------------------
# Insert the real Cloudflare Pages origin once it exists (Pages assigns it
# on first deploy -- see DEPLOY_RAILWAY_CLOUDFLARE.md step "generate backend
# domain" / "deploy frontend"). A comma-separated list; every entry must be
# an exact scheme+host(+port) origin, never a wildcard or suffix pattern.
CORS_ORIGINS=https://<your-project>.pages.dev

# -- basic in-process rate limiting (task §9) ---------------------------------
# Single-process, single-replica limiter (see
# VIETLAW_LIMITED_DEMO_DEPLOYMENT_ARCHITECTURE_V1.md, "Rate-limit
# limitation") -- resets on restart. Exactly one replica is a MANUAL Railway
# dashboard setting (Settings -> Scaling/Replicas -> 1); `railway.toml` no
# longer sets `numReplicas` (Deployment Correction Round 1, MEDIUM-03 --
# Railway's config-as-code schema does not support that field and silently
# ignores it). Conservative limited-demo defaults; tune after observing
# real traffic.
VIETLAW_RATE_LIMIT_ENABLED=1
VIETLAW_RATE_LIMIT_PER_IP_PER_MINUTE=20
VIETLAW_RATE_LIMIT_PER_CONVERSATION_PER_MINUTE=12
VIETLAW_MAX_MESSAGE_CHARS=3000
VIETLAW_MAX_CONCURRENT_REQUESTS=4

# -- trusted client-IP extraction (Deployment Correction Round 1, MEDIUM-02) --
# Railway's edge sits in front of this process and sets `X-Real-IP` itself
# on every request it forwards -- unlike `X-Forwarded-For`, which this
# backend NEVER trusts for rate-limit identity (any client could set that
# header directly against this backend, bypassing Railway's edge entirely,
# and rotate it to bypass a per-IP limit). Set this to 1 only in the actual
# Railway deployment, where `X-Real-IP` is genuinely edge-supplied; leave it
# 0 (the default) for local development and any environment where a client
# could reach this backend directly, so no proxy header is trusted at all
# and only the raw socket peer is used.
VIETLAW_TRUST_PROXY_HEADERS=1
